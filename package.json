{
  "name": "rikkun-world",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:ui": "playwright test e2e/ui-gate.spec.ts",
    "test:e2e:fast": "playwright test e2e/smoke.spec.ts e2e/m6-shots.spec.ts e2e/partsPage.spec.ts",
    "test:e2e:calm": "playwright test --config playwright.calm.config.ts",
    "test:e2e:shadow": "playwright test --config playwright.shadow.config.ts",
    "perf": "playwright test --config playwright.perf.config.ts",
    "check": "npm run typecheck && npm run test && npm run test:e2e",
    "check:fast": "npm run typecheck && npm run test",
    "pack:char": "node scripts/pack-char-atlas.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.6",
    "ffmpeg-static": "^5.3.0",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
